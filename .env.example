# 复制为 .env（已被 .gitignore 排除）。这里只放密钥；变量名要与 config.toml 里的 *_env 字段一致。

# 实时模型走 chat completions 接口（realtime_llm.mode = "openai_api"）时的密钥；用 llama.cpp 部署时不需要
REALTIME_LLM_API_KEY=

# 后台 agent 用的远端 LLM
AGENT_LLM_API_KEY=

# MCP 检索服务的认证头的完整值，例如 "Bearer xxxxx"
MCP_SEARCH_AUTH=

# 可选：改用别处的配置文件
# AGENTIC_MEETING_CONFIG=config/config.toml

# ---- 容器编排（compose.yaml）读的变量，见 docs/zh-CN/containers.md；不用容器就不用管 ----
# 要启动的可选服务
# COMPOSE_PROFILES=realtime,tts,embedding
# 叠加哪些文件（用 : 分隔），例如 NVIDIA 显卡：
# COMPOSE_FILE=compose.yaml:docker/compose.cuda.yaml
# 模型文件，写法与 config.toml 相同（相对仓库根目录）
# ASR_MODEL=models/asr/
# ASR_MMPROJ=models/asr/
# REALTIME_MODEL=models/llm/
# REALTIME_MMPROJ=
# TTS_MODEL=models/tts/
# TTS_CODEC=models/tts/
# EMBEDDING_MODEL=models/embedding/
# 应用容器的用户（data/ 要对它可写），默认 1000
# AGENTIC_MEETING_UID=1000
# AGENTIC_MEETING_GID=1000

# 复制为 .env（已被 .gitignore 排除）。这里只放密钥；变量名要与 config.toml 里的 *_env 字段一致。

# 实时模型走 chat completions 接口（realtime_llm.mode = "openai_api"）时的密钥；用 llama.cpp 部署时不需要
REALTIME_LLM_API_KEY=

# 后台 agent 用的远端 LLM
AGENT_LLM_API_KEY=

# MCP 检索服务的认证头的完整值，例如 "Bearer xxxxx"
MCP_SEARCH_AUTH=

# 可选：改用别处的配置文件
# AGENTIC_MEETING_CONFIG=config/config.toml
